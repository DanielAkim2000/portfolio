# Copier en .env.local pour le développement (jamais committé : .env* est ignoré par git).
# Base locale : pnpm db:up (docker-compose.dev.yml, port 5434)
DATABASE_URL="postgresql://portfolio:portfolio_dev@127.0.0.1:5434/portfolio_dev"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Pour pnpm seed:admin (sur une base distante : mot de passe de 12 caractères minimum)
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="change-me-locally"
